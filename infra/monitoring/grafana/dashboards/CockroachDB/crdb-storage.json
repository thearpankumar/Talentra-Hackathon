{
 "uid": "crdb-storage",
 "title": "CockroachDB Storage, LSM and Compaction",
 "tags": [
  "talentra",
  "cockroachdb",
  "storage",
  "pebble"
 ],
 "description": "Pebble LSM health: L0 sublevels, read/write amplification, compactions, WAL fsync, block cache, disk, admission control.",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "cluster",
    "label": "Cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"cockroachdb\"}, cluster)",
     "refId": "var-cluster",
     "qryType": 1
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "regex": "",
    "hide": 0,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "allValue": ".*"
   },
   {
    "name": "node",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(sys_uptime{job=\"cockroachdb\",cluster=~\"$cluster\"}, instance)",
     "refId": "var-node",
     "qryType": 1
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "regex": "",
    "hide": 0,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "allValue": ".*"
   }
  ]
 },
