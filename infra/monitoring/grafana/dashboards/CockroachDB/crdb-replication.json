    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(sys_uptime{job=\"cockroachdb\",cluster=~\"$cluster\"}, instance)",
     "refId": "var-node",
     "qryType": 1
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "regex": "",
    "hide": 0,
    "current": {
