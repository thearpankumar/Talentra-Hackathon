 "annotations": {
  "list": [
   {
    "name": "Alerts firing",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\",severity=~\"warning|critical\",alertname!=\"Watchdog\"}",
    "step": "60s",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{summary}}",
    "tagKeys": "severity",
    "useValueForTime": false
   },
   {
    "name": "Container restarts",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(container_start_time_seconds{name!=\"\"}[1m]) > 0",
    "step": "60s",
    "titleFormat": "restart: {{name}}",
    "textFormat": "container restarted",
    "tagKeys": "severity",
    "useValueForTime": false
   },
   {
    "name": "CockroachDB node restarts",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "purple",
    "expr": "resets(sys_uptime{job=\"cockroachdb\"}[1m]) > 0",
    "step": "60s",
    "titleFormat": "crdb restart: {{instance}}",
    "textFormat": "node restarted",
    "tagKeys": "severity",
    "useValueForTime": false
   },
   {
    "name": "Backup succeeded",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "green",
    "expr": "changes(talentra_backup_last_success_timestamp_seconds{op=\"backup\"}[1m]) > 0",
    "step": "60s",
    "titleFormat": "backup ok: {{type}} {{dest}}",
    "textFormat": "",
    "tagKeys": "severity",
    "useValueForTime": false
   }
  ]
