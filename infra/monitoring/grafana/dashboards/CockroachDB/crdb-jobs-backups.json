  {
   "id": 2,
   "type": "gauge",
   "title": "Time since last successful backup",
   "description": "RPO = data you would lose if main died now. Target 2h (recording rule talentra:backup_rpo_target_seconds).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 5,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - max(talentra_backup_last_success_timestamp_seconds{op=\"backup\"})",
     "legendFormat": "",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 3600
       },
       {
        "color": "red",
        "value": 7200
       }
      ]
     },
     "min": 0,
     "max": 14400
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true
