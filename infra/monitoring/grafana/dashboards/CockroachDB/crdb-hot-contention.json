{
 "uid": "crdb-hot-contention",
 "title": "CockroachDB Hot Ranges and Contention",
 "tags": [
  "talentra",
  "cockroachdb",
  "hotspots",
  "contention"
 ],
 "description": "Load per node/range, lock & latch waits, txn pushes, deadlocks, contended queries.",
 "editable": false,
 "graphTooltip": 1,
