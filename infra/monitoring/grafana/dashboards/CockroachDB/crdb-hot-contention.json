  {
   "id": 6,
   "type": "timeseries",
   "title": "Request imbalance: max/avg ratio per metric",
   "description": "1.0 = perfectly even. With 1W-2R pinning this is expected to be high for writes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rebalancing_requestspersecond{job=\"cockroachdb\",cluster=~\"$cluster\",instance=~\"$node\"}) / clamp_min(avg(rebalancing_requestspersecond{job=\"cockroachdb\",cluster=~\"$cluster\",instance=~\"$node\"}), 1e-9)",
     "legendFormat": "requests",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(replicas_cpunanospersecond{job=\"cockroachdb\",cluster=~\"$cluster\",instance=~\"$node\"}) / clamp_min(avg(replicas_cpunanospersecond{job=\"cockroachdb\",cluster=~\"$cluster\",instance=~\"$node\"}), 1e-9)",
     "legendFormat": "cpu",
     "range": true,
     "instant": false
