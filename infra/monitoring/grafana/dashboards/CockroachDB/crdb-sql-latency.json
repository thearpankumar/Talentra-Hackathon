 "tags": [
  "talentra",
  "cockroachdb",
  "sql",
  "latency"
 ],
 "description": "Latency percentiles (service/exec/txn), statement mix, failures, restarts, active statements, sessions by user and long-running queries.",
 "editable": false,
 "graphTooltip": 1,
