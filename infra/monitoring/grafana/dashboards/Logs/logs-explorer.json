 ],
 "annotations": {
  "list": [
   {
    "name": "Alerts firing",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\",severity=~\"warning|critical\",alertname!=\"Watchdog\"}",
    "step": "60s",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{summary}}",
    "tagKeys": "severity",
    "useValueForTime": false
   }
  ]
 },
