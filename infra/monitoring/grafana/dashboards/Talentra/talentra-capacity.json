{
 "uid": "talentra-capacity",
 "title": "Capacity and Forecast",
 "tags": [
  "talentra",
  "capacity",
  "forecast"
 ],
 "description": "Disk-full prediction, memory pressure, EBS IOPS/throughput saturation vs gp3 6000 IOPS / 300 MB/s, memory budget.",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "horizon",
    "label": "Forecast horizon",
    "type": "custom",
    "query": "1d,3d,7d,14d,30d",
    "multi": false,
    "includeAll": false,
    "current": {
     "selected": true,
     "text": "7d",
     "value": "7d"
    },
    "options": [
     {
      "selected": false,
      "text": "1d",
      "value": "1d"
     },
     {
      "selected": false,
      "text": "3d",
      "value": "3d"
     },
     {
      "selected": true,
      "text": "7d",
      "value": "7d"
     },
     {
      "selected": false,
      "text": "14d",
      "value": "14d"
     },
     {
      "selected": false,
      "text": "30d",
      "value": "30d"
     }
    ]
   },
   {
    "name": "lookback",
    "label": "Trend lookback",
    "type": "custom",
    "query": "1h,6h,12h,1d,3d",
    "multi": false,
    "includeAll": false,
    "current": {
     "selected": true,
     "text": "6h",
     "value": "6h"
    },
    "options": [
     {
      "selected": false,
      "text": "1h",
      "value": "1h"
     },
     {
      "selected": true,
      "text": "6h",
      "value": "6h"
     },
     {
      "selected": false,
      "text": "12h",
      "value": "12h"
     },
     {
      "selected": false,
      "text": "1d",
      "value": "1d"
     },
     {
      "selected": false,
      "text": "3d",
      "value": "3d"
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "id": 1,
   "title": "Disk",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Days until the first filesystem is full (linear trend)",
   "description": "avail / consumption rate over the trend lookback, worst filesystem. Very large = not shrinking. Empty = no filesystem is shrinking.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*|vfat|iso9660\",mountpoint!~\"/(boot|run|sys|dev|proc|host/(run|sys|dev|proc)).*|/var/lib/docker/.+|/etc/(hosts|hostname|resolv.conf)\"} / clamp_min(-deriv(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*|vfat|iso9660\",mountpoint!~\"/(boot|run|sys|dev|proc|host/(run|sys|dev|proc)).*|/var/lib/docker/.+|/etc/(hosts|hostname|resolv.conf)\"}[$lookback]), 1e-9)) / 86400",
     "legendFormat": "",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "d",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 2
       },
       {
        "color": "green",
        "value": 7
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto",
    "orientation": "auto"
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Free space and predict_linear forecast",
   "description": "Dotted projections below zero mean the filesystem fills inside that horizon (alert: HostDiskWillFillIn24h).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 18,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*|vfat|iso9660\",mountpoint!~\"/(boot|run|sys|dev|proc|host/(run|sys|dev|proc)).*|/var/lib/docker/.+|/etc/(hosts|hostname|resolv.conf)\"}",
     "legendFormat": "free {{mountpoint}}",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*|vfat|iso9660\",mountpoint!~\"/(boot|run|sys|dev|proc|host/(run|sys|dev|proc)).*|/var/lib/docker/.+|/etc/(hosts|hostname|resolv.conf)\"}[$lookback], 86400)",
     "legendFormat": "in 24h {{mountpoint}}",
     "range": true,
     "instant": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*|vfat|iso9660\",mountpoint!~\"/(boot|run|sys|dev|proc|host/(run|sys|dev|proc)).*|/var/lib/docker/.+|/etc/(hosts|hostname|resolv.conf)\"}[$lookback], 7*86400)",
     "legendFormat": "in 7d {{mountpoint}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "lineInterpolation": "linear",
      "thresholdsStyle": {
       "mode": "off"
      },
      "axisPlacement": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
