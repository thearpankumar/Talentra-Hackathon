   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (cluster) (rate(sql_select_count{job=\"cockroachdb\",cluster=~\"$cluster\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} select",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (cluster) (rate(sql_insert_count{job=\"cockroachdb\",cluster=~\"$cluster\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} insert",
     "range": true,
     "instant": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (cluster) (rate(sql_update_count{job=\"cockroachdb\",cluster=~\"$cluster\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} update",
     "range": true,
     "instant": false
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (cluster) (rate(sql_delete_count{job=\"cockroachdb\",cluster=~\"$cluster\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} delete",
     "range": true,
     "instant": false
    }
   ],
