{
 "uid": "talentra-overview",
 "title": "Talentra Overview",
 "tags": [
  "talentra",
  "overview",
  "home"
 ],
 "description": "One-screen health summary: targets, alerts, CockroachDB, backups, edge, host.",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "cluster",
    "label": "CockroachDB cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"cockroachdb\"}, cluster)",
     "refId": "var-cluster",
     "qryType": 1
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "regex": "",
    "hide": 0,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "allValue": ".*"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "id": 1,
   "title": "Health at a glance",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Targets up",
   "description": "Scrape targets currently UP (optional integrations excluded).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(up{optional!=\"true\"})",
     "legendFormat": "",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
