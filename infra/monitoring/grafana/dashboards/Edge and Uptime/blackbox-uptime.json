{
 "uid": "blackbox-uptime",
 "title": "Uptime and SSL (Blackbox)",
 "tags": [
  "talentra",
  "blackbox",
  "uptime",
  "tls"
 ],
 "description": "HTTPS/HTTP probes of public hostnames, TLS handshake/cert expiry, TCP probes of SQL ports.",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "timezone": "browser",
