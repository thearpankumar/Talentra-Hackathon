{
 "uid": "caddy",
 "title": "Caddy (HTTPS edge)",
 "tags": [
  "talentra",
  "caddy",
  "edge",
  "tls"
 ],
 "description": "Requests, status codes, latency, upstream health, config reloads, certificate expiry. Per-request metrics need the global `metrics` option (see INTEGRATION_REQUESTS.md).",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "timezone": "browser",
 "refresh": "30s",
