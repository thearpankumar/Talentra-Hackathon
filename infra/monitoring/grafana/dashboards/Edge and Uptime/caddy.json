    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(caddy_http_requests_total, server)",
     "refId": "var-server",
     "qryType": 1
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "regex": "",
    "hide": 0,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "allValue": ".*"
   }
  ]
 },
