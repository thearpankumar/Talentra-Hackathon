# Copy to .env (never commit). Local compose works with no .env at all; prod requires the two REQUIRED values.

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                 # REQUIRED in prod (local default: admin)
GRAFANA_SECRET_KEY=                     # optional: openssl rand -hex 32 (stable key for encrypted datasource secrets)
MONITORING_HOST=monitoring.talentra.thearpanhq.in

# ---- SQL exporter DSNs (CockroachDB monitoring role; see README "Monitoring SQL role") ----
# Create the role once on each cluster:  CREATE USER talentra_monitor WITH PASSWORD '...';
#   GRANT SYSTEM VIEWACTIVITY, VIEWCLUSTERMETADATA, VIEWJOB, VIEWCLUSTERSETTING TO talentra_monitor;
#   GRANT CONNECT ON DATABASE talentra TO talentra_monitor;  (+ SELECT is NOT needed: only statistics are read)
# URL-encode the password. allow_unsafe_internals is needed for crdb_internal.tables / table_row_statistics.
# Hosts must match the certificate SANs: main-crdb1 / backup-crdb are listed in CERT_HOSTS.
SQL_EXPORTER_MAIN_DSN=postgres://talentra_monitor:CHANGE_ME@main-crdb1:26257/defaultdb?sslmode=verify-full&sslrootcert=/certs/main/ca.crt&options=-c%20allow_unsafe_internals%3Dtrue
SQL_EXPORTER_BACKUP_DSN=postgres://talentra_monitor:CHANGE_ME@backup-crdb:26257/defaultdb?sslmode=verify-full&sslrootcert=/certs/backup/ca.crt&options=-c%20allow_unsafe_internals%3Dtrue

# ---- Alert delivery: set at least one, otherwise alerts are only visible in Alertmanager/Grafana ----
SLACK_WEBHOOK_URL=                      # Slack incoming webhook
SLACK_CHANNEL=#alerts
ALERT_WEBHOOK_URL=                      # generic JSON webhook (ntfy, Teams relay, PagerDuty/Opsgenie bridge...)
SMTP_SMARTHOST=                         # e.g. email-smtp.us-east-1.amazonaws.com:587 (SES)
SMTP_FROM=alerts@talentra.thearpanhq.in
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
WATCHDOG_WEBHOOK_URL=                   # dead-man's switch (healthchecks.io style ping URL)

# ---- Retention / limits (prod) ----
PROM_RETENTION=15d
PROM_RETENTION_SIZE=8GB                 # hard cap; oldest blocks dropped first
PROM_MEM_LIMIT=1280m
GRAFANA_MEM_LIMIT=384m
LOKI_MEM_LIMIT=512m
NODE_EXPORTER_LISTEN=172.17.0.1:9100    # docker0 address; Prometheus reaches it via host-gateway

# ---- Opt-in CloudWatch (profile "cloudwatch"): leave empty to use the EC2 instance profile ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
