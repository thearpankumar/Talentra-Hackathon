# Copy to .env. Alphanumeric only, 12+ chars. Role passwords should match main-db/.env (same roles exist on both clusters).
BACKUP_ADMIN_PASSWORD=
TALENTRA_ADMIN_PASSWORD=
TALENTRA_APP_RW_PASSWORD=
TALENTRA_APP_RO_PASSWORD=
TALENTRA_ANALYST_PASSWORD=
TALENTRA_AUDIT_READER_PASSWORD=
TALENTRA_MONITOR_PASSWORD=
CRDB_VERSION=v26.2.8
# Enterprise Free license: same key/org as main-db/.env (see main-db/.env.example). Empty = skipped with a log line.
CRDB_LICENSE_KEY=
CRDB_ORG=
