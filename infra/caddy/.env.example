ACME_EMAIL=you@example.com
APEX_HOST=talentra.thearpanhq.in
DB_HOST=db.talentra.thearpanhq.in
BACKUP_HOST=backup.talentra.thearpanhq.in
MONITORING_HOST=monitoring.talentra.thearpanhq.in
# Basic auth in front of the two DB Consoles. Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Keep the single quotes; every $ in the bcrypt hash is literal.
BASIC_AUTH_USER=talentra
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_BCRYPT_HASH'
