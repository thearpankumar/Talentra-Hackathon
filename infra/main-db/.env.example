# Copy to .env and fill in. Passwords: 12+ chars, ALPHANUMERIC ONLY (they go into SQL strings and URLs unescaped).
# Generate each with: openssl rand -hex 16
TALENTRA_ADMIN_PASSWORD=
TALENTRA_APP_RW_PASSWORD=
TALENTRA_APP_RO_PASSWORD=
TALENTRA_ANALYST_PASSWORD=
TALENTRA_AUDIT_READER_PASSWORD=
TALENTRA_BACKUP_PASSWORD=
# Read-only monitoring role used by the SQL exporter (infra/monitoring/.env SQL_EXPORTER_*_DSN must use the same value)
TALENTRA_MONITOR_PASSWORD=
# Must equal BACKUP_ADMIN_PASSWORD in infra/backup-db/.env (the handler logs into the backup cluster with it)
BACKUP_ADMIN_PASSWORD=

# CockroachDB image (pinned)
CRDB_VERSION=v26.2.8

# CockroachDB Enterprise Free license. Without a key throttling starts 2026-10-22 (7-day grace on a fresh cluster).
# Create it at https://www.cockroachlabs.com/ -> Console -> Licenses (Enterprise Free; needs a free account), then paste
# the key (crl-0-...) here and the organization name EXACTLY as shown there. Same two values go into backup-db/.env.
# Empty = bootstrap logs "LICENSE: ... skipping" and continues. Re-running the bootstrap is safe (idempotent).
CRDB_LICENSE_KEY=
CRDB_ORG=

# Backup schedule (minutes): full every 24h, incremental hourly, restore into the backup cluster every 6h
FULL_EVERY_MIN=1440
INCR_EVERY_MIN=5
SYNC_EVERY_MIN=360
# Optional S3 copy, e.g. s3://bucket/talentra?AUTH=implicit&AWS_REGION=us-east-1  (empty = disabled)
BACKUP_S3_URI=
# Memory tuning for the 32 GB EC2 host (defaults in compose are larger; see aws-scripts/EC2_SIZING.md)
N1_CACHE=2GiB
N1_SQL_MEM=1536MiB
N1_MEM_LIMIT=5g
N2_CACHE=1536MiB
N2_SQL_MEM=1GiB
N2_MEM_LIMIT=4g
N3_CACHE=1536MiB
N3_SQL_MEM=1GiB
N3_MEM_LIMIT=4g
