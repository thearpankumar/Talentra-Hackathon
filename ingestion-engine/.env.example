# AWS / Bedrock (never commit the real .env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # needed for temporary (ASIA...) credentials
AWS_DEFAULT_REGION=us-east-1
BEDROCK_REGION=us-east-1
# Z.ai GLM 5 on Bedrock (verify with `uv run engine llm-discover`)
BEDROCK_MODEL_ID=zai.glm-5
# Fallback tried when the primary model is unavailable (comma separated)
BEDROCK_FALLBACK_MODEL_IDS=us.anthropic.claude-3-5-haiku-20241022-v1:0
# LLM_PROVIDER: bedrock | fake | auto (auto = bedrock, then fake if unreachable)
LLM_PROVIDER=auto
# Max LLM tokens (in+out) per process before the cost guard refuses further calls
LLM_TOKEN_BUDGET=400000

# Target database
TARGET_DB_URL=postgresql://root@localhost:26357/talentra?sslmode=disable
TARGET_SCHEMA=public
# Local engine state (SQLite)
ENGINE_STATE_DIR=./.engine_state
